# Copy this file to .env and replace the placeholders. Never commit .env.

# PostgreSQL container (docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cash_db
# Host port. Change it if 5432 is already in use, and update the connection string below.
POSTGRES_PORT=5432

# API database connection. Must match the values above.
ConnectionStrings__DefaultConnection='Host=localhost;Port=5432;Database=cash_db;Username=postgres;Password=change-me'

# API JWT signing key, required, at least 32 bytes. Generate one with: openssl rand -hex 32
Jwt__Secret=

# Optional. While Payphone__Token is empty, /api/billing/payphone/confirm returns a simulated approval.
Payphone__Token=
Payphone__StoreId=
